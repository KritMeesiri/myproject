/* Enclave.edl - Top EDL file. */

enclave {

    include "user_types.h" /* buffer_t */

    /* Import ECALL/OCALL from sub-directory EDLs.
     *  [from]: specifies the location of EDL file.
     *  [import]: specifies the functions to import,
     *  [*]: implies to import all functions.
     */

    from "Edger8rSyntax/Types.edl" import *;
    from "Edger8rSyntax/Pointers.edl" import *;
    from "Edger8rSyntax/Arrays.edl" import *;
    from "Edger8rSyntax/Functions.edl" import *;

    from "TrustedLibrary/Libc.edl" import *;
    from "TrustedLibrary/Libcxx.edl" import ecall_exception, ecall_map;
    from "TrustedLibrary/Thread.edl" import *;

    trusted {
        /*
         * ecall_phase4_signcrypt — Phase 4: Clustered TEE-Assisted PQ Signcryption
         *
         * Maps to paper Section III.C.4.  All SGX-SDK crypto (AES-GCM, SHA-256,
         * sgx_read_rand) runs inside this ECALL.  Kyber768 encapsulation and
         * ML-DSA-65 signing are delegated to the host via OCALLs because liboqs
         * cannot link against SGX trusted libraries.
         *
         * Size parameters MUST precede the buffers that reference them so that
         * the edger8r can validate the [in/out, size=N] annotations.
         *
         * Output layout:
         *   out_ct       — AES-GCM ciphertext of aggregated batch (ct_agg_size B)
         *   out_iv       — 12-byte IV generated by sgx_aes_gcm_encrypt
         *   out_tag      — 16-byte AES-GCM authentication tag
         *   out_ctk      — 1088-byte Kyber768 ciphertext CTK_e
         *   out_enc_ke   — 32-byte masked epoch key: EncK_e = K_e XOR KDF(SS_e)
         *   out_ct_abe   — 60-byte simulated CP-ABE output: IV(12)||Tag(16)||Enc(32)
         *   out_batch_digest — 32-byte batch commitment h_e (SHA-256)
         *   out_signature    — ML-DSA-65 signature sigma_e (up to 3309 bytes)
         *   out_sig_len      — actual signature length written
         *   out_valid_count  — records that passed PUF auth verification
         */
        public int ecall_phase4_signcrypt(
            /* --- scalar inputs --- */
            uint32_t epoch_id,
            uint32_t polref_len,
            uint32_t num_records,
            uint32_t auth_buf_size,
            uint32_t ct_agg_size,
            /* --- buffer inputs (size params declared above) --- */
            [in, size=32]              const uint8_t *epoch_challenge,
            [in, size=polref_len]      const uint8_t *pol_ref,
            [in, size=32]              const uint8_t *batch_pre_digest,
            [in, size=auth_buf_size]   const uint8_t *auth_records,
            [in, size=ct_agg_size]     const uint8_t *ct_agg,
            [in, size=1184]            const uint8_t *hdfs_pk,
            /* --- buffer outputs --- */
            [out, size=ct_agg_size]    uint8_t *out_ct,
            [out, size=12]             uint8_t *out_iv,
            [out, size=16]             uint8_t *out_tag,
            [out, size=1088]           uint8_t *out_ctk,
            [out, size=32]             uint8_t *out_enc_ke,
            [out, size=60]             uint8_t *out_ct_abe,
            [out, size=32]             uint8_t *out_batch_digest,
            [out, size=3309]           uint8_t *out_signature,
            /* --- scalar outputs --- */
            [out] uint32_t *out_sig_len,
            [out] uint32_t *out_valid_count
        );
    };

    untrusted {
        /*
         * ocall_print_string — print from inside the enclave.
         */
        void ocall_print_string([in, string] const char *str);

        /*
         * ocall_kyber768_encaps — Kyber768 KEM encapsulation on the host.
         * Called from inside the enclave in Phase 4 Step 5 to protect K_e.
         * The host uses liboqs: OQS_KEM_kyber_768_encaps(ct, ss, pk).
         */
        int ocall_kyber768_encaps(
            [in,  size=1184] const uint8_t *pk,
            [out, size=1088]       uint8_t *ct,
            [out, size=32]         uint8_t *ss
        );

        /*
         * ocall_dilithium_sign — ML-DSA-65 signing on the host.
         * Called from inside the enclave in Phase 4 Step 8 to sign h_e.
         * The host uses liboqs: OQS_SIG_ml_dsa_65_sign(..., g_mldsa_sk).
         */
        int ocall_dilithium_sign(
            uint32_t              msg_len,
            [in,  size=msg_len]   const uint8_t *msg,
            [out, size=3309]            uint8_t *sig,
            [out]                 uint32_t       *sig_len
        );
    };

};
